# Copiá este archivo a .env y completá los valores. El .env nunca se sube al repo.
# Las variables VITE_* quedan visibles en el navegador: nunca pongas ahí claves secretas.

# true = datos de prueba en memoria, sin base de datos (ver src/integrations/supabase/mockClient.ts)
VITE_USE_MOCK=true

# Supabase: cliente del navegador (clave pública)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase: lado servidor (server/api/*)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secreta: solo en el servidor (alta de usuarios del panel)
SUPABASE_SERVICE_ROLE_KEY=

# Migue (chat): secreta, solo en el servidor
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Sal para el hash de la IP en el límite de mensajes del chat
RATE_LIMIT_SALT=

# ── Portal de familias ───────────────────────────────────────────────────────
# true = el portal usa server/api/portal/* contra Supabase (si no, solo en modo mock)
VITE_PORTAL_ENABLED=
# Secreta: firma los códigos de invitación, los intentos de ingreso y los enlaces de voz
PORTAL_CODE_PEPPER=
# Etapas de información de salud que se prenden, separadas por comas:
# consent,info,practice,ai,docs,hc_digital,activities,recordings
# (cada una necesita su script SQL; ver supabase/sql_para_copiar/README.md)
PORTAL_CLINICAL_FEATURES=
# Opcionales: cada cuántas horas se vuelve a pedir la contraseña para ver
# información de salud (12) y cuántos minutos vale para descargar (15)
PORTAL_REAUTH_INFO_HOURS=
PORTAL_REAUTH_DOWNLOAD_MIN=

# ── Ejercicios adaptados con IA (etapa "ai") ─────────────────────────────────
# Opcionales: clave y modelo aparte (si no, los de Migue / openai/gpt-4o-mini)
# y el tope de pedidos por día del centro (150)
OPENROUTER_DRAFT_API_KEY=
OPENROUTER_DRAFT_MODEL=
AI_DRAFT_DAILY_CAP=

# ── Voz y reconocimiento de habla (secretas, solo en el servidor) ────────────
# Voz de «Escuchar» y reconocimiento de «Me grabo». Con una sola clave alcanza;
# la segunda es de respaldo
AZURE_SPEECH_KEY_1=
AZURE_SPEECH_KEY_2=
AZURE_SPEECH_REGION=brazilsouth
# Opcional: la voz (es-AR-ElenaNeural)
AZURE_SPEECH_VOICE=
# Respaldo para reconocer las grabaciones de «Me grabo»
GROQ_API_KEY=
# Opcional: en qué orden se prueba el reconocimiento (azure,groq)
PORTAL_STT=

# ── Tareas programadas ───────────────────────────────────────────────────────
# Secreta: Vercel la manda a /api/cron/limpieza (borrado diario de los audios
# de «Me grabo» con más de 90 días). Sin ella la limpieza diaria no corre.
# Una cadena larga al azar, por ejemplo: openssl rand -hex 32
CRON_SECRET=
